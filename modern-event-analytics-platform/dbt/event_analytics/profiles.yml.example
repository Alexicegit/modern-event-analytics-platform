event_analytics:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "<your_account>"
      user: "<your_user>"
      password: "<your_password>"
      role: "<your_role>"
      database: EVENT_ANALYTICS_DB
      warehouse: EVENT_ANALYTICS_WH
      schema: RAW
      threads: 4
      client_session_keep_alive: false
